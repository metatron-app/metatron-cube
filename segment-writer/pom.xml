<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.metatron</groupId>
    <artifactId>druid-segment-writer</artifactId>
    <name>druid-segment-writer</name>
    <description>
        Hadoop-free, embeddable Druid segment writer: build segments in-process
        (IncrementalIndex -> IndexMergerV9) and push them to deep storage, for use
        from external engines such as Spark. Produces a shaded "-spark" jar with
        Guava/Jackson relocated to avoid clashing with the host runtime.
    </description>

    <parent>
        <groupId>app.metatron</groupId>
        <artifactId>druid</artifactId>
        <version>2021.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencies>
        <!-- compile scope: these are bundled into the shaded jar -->
        <dependency>
            <groupId>app.metatron</groupId>
            <artifactId>druid-processing</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>app.metatron</groupId>
            <artifactId>druid-common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>app.metatron</groupId>
            <artifactId>java-util</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>app.metatron.extensions</groupId>
            <artifactId>druid-s3-extensions</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- Lucene 10 text/secondary indexing so the writer can build Lucene-indexed
             columns. Exclude druid-sql (Calcite) — only needed for query planning, not
             for building segments. -->
        <dependency>
            <groupId>app.metatron.extensions</groupId>
            <artifactId>druid-lucene10-extensions</artifactId>
            <version>${project.parent.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>app.metatron</groupId>
                    <artifactId>druid-sql</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- lucene-common / geometry / jts are 'provided' in the extensions above (so not
             transitive); pull them at compile scope so they're bundled in the shaded jar and
             available at runtime (TextIndexingStrategy, Lucenes -> geometry, etc.). -->
        <dependency>
            <groupId>app.metatron.extensions</groupId>
            <artifactId>druid-lucene-common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>app.metatron.extensions</groupId>
            <artifactId>druid-geometry-extensions</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>1.16.0</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- override the project-managed 2.2 (too old for Java 21 / module-info) -->
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- keep the thin jar as the main artifact; attach the fat jar as -spark -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>spark</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <!-- the two libraries Spark also ships at different versions -->
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>io.druid.segwriter.shaded.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>io.druid.segwriter.shaded.jackson</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!-- merge META-INF/services (aws-sdk v2 uses ServiceLoader) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
