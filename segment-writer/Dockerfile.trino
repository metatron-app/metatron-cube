# Minimal runner for TrinoIngestion (single-process, Spark-free daily re-index).
# The shaded jar carries all deps (trino-jdbc, lucene10, druid-processing, s3). Java 21.
#   mvn -f segment-writer/pom.xml -DskipTests package
#   docker buildx build --platform linux/amd64 --provenance=false -f segment-writer/Dockerfile.trino \
#       -t nas2.s2dev.net:5050/adp/trino-ingester:1 segment-writer/ --push
# JRE=eclipse-temurin:21-jre (default) for the jdbc-435 build; override to a Java 22+ JRE for a jdbc-466+ (spooling) jar.
ARG JRE=eclipse-temurin:21-jre
FROM ${JRE}
COPY target/druid-segment-writer-*-spark.jar /app/ingester.jar
WORKDIR /app
